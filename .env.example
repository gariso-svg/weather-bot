# Copy this file to .env and fill in your values.
# Never commit .env to version control.

# Telegram Bot token from @BotFather
BOT_TOKEN=

# Weatherbit API key (free tier at https://www.weatherbit.io/account/create)
WEATHERBIT_API_KEY=

# --- Webhook mode only (leave blank for polling mode) ---

# Full public HTTPS URL of your server, without trailing slash
# Example: https://yourdomain.com
WEBHOOK_URL=

# Port for the webhook server (Telegram supports 443, 80, 88, 8443)
PORT=8443
